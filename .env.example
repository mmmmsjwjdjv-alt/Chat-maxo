# ==========================================
# MAXO CHAT — Production Environment Template
# ==========================================

# Server Network Configuration
PORT=3000

# PostgreSQL Database Connection URL
# Example: postgres://username:password@localhost:5432/maxo_chat
DATABASE_URL=postgres://maxo_user:YOUR_POSTGRES_PASSWORD@localhost:5432/maxo_chat

# Initial Owner Bootstrap Password (default is MAXO1212)
# Username is strictly reserved as: MAXO
BOOTSTRAP_OWNER_PASSWORD=MAXO1212

# JSON Web Token Secret (used for signing session tokens)
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_KEY_HERE

# Legacy JSON Source Integration (Server-Side only)
LEGACY_JSON_URL=https://tk-server.ir/json/CHAT-MAXO.json
LEGACY_JSON_EDIT_PASSWORD=MAXO

# Public Frontend API URL (if frontend and backend hosted separately)
VITE_API_URL=http://localhost:3000

# AI Studio Optional Key
# GEMINI_API_KEY=MY_GEMINI_API_KEY
