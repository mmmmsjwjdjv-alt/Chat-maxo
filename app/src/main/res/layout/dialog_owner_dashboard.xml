<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👑 پنل اختصاصی مالک ارشد MAXO"
        android:textColor="@color/white_pure"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_owner_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:text="تعداد کاربران ثبت‌شده: ۱ | وضعیت چت: فعال"
        android:textColor="@color/white_platinum"
        android:textSize="11sp" />

    <!-- Chat status toggle -->
    <Button
        android:id="@+id/btn_toggle_chat"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/surface_card"
        android:text="🔒 بستن موقت گفتگوی همگانی"
        android:textColor="@color/white_pure"
        android:textSize="12sp" />

    <!-- Test JSON write sync -->
    <Button
        android:id="@+id/btn_test_write_capability"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/surface_card"
        android:text="🔄 استعلام قابلیت نوشتن در CHAT-MAXO.json"
        android:textColor="@color/white_pure"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btn_close_dashboard"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="14dp"
        android:backgroundTint="@color/white_pure"
        android:text="بستن پنل"
        android:textColor="@color/bg_dark"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
