<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_rounded_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👤 پروفایل کاربری"
        android:textColor="@color/white_pure"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_profile_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:padding="12dp"
        android:text="نام کاربری: ...\nنقش: ..."
        android:textColor="@color/white_platinum"
        android:textSize="11sp"
        android:lineSpacingExtra="3dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="تغییر رمز عبور:"
        android:textColor="@color/gray_text"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/et_curr_password"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:hint="رمز عبور فعلی"
        android:textColorHint="@color/gray_muted"
        android:textColor="@color/white_pure"
        android:paddingHorizontal="12dp"
        android:textSize="12sp"
        android:inputType="textPassword" />

    <EditText
        android:id="@+id/et_new_password"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_input_field"
        android:hint="رمز عبور جدید (حداقل ۶ کاراکتر)"
        android:textColorHint="@color/gray_muted"
        android:textColor="@color/white_pure"
        android:paddingHorizontal="12dp"
        android:textSize="12sp"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/btn_change_password"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/surface_card"
        android:text="ثبت رمز جدید"
        android:textColor="@color/white_pure"
        android:textSize="11sp" />

    <Button
        android:id="@+id/btn_logout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/accent_red"
        android:text="خروج از حساب کاربری"
        android:textColor="@color/white_pure"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
