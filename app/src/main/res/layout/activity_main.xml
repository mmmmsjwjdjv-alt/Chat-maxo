<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- Logo Monogram -->
        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="M"
                android:textColor="@color/white_pure"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAXO CHAT"
                android:textColor="@color/white_pure"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tv_app_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="گفتگوی همگانی بلادرنگ"
                android:textColor="@color/gray_text"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Actions -->
        <ImageButton
            android:id="@+id/btn_endpoint_info"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="وضعیت منبع آنلاین"
            android:src="@drawable/ic_info" />

        <ImageButton
            android:id="@+id/btn_admin"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="پنل مدیریت"
            android:src="@drawable/ic_shield"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_refresh"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="بروزرسانی"
            android:src="@drawable/ic_refresh" />

        <ImageButton
            android:id="@+id/btn_profile"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="پروفایل کاربری"
            android:src="@drawable/ic_user" />
    </LinearLayout>

    <!-- Source Connection Banner -->
    <LinearLayout
        android:id="@+id/banner_source_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/bg_rounded_card"
            android:backgroundTint="@color/accent_green" />

        <TextView
            android:id="@+id/tv_source_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="منبع آنلاین: CHAT-MAXO.json (متصل)"
            android:textColor="@color/gray_text"
            android:textSize="11sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="جزئیات"
            android:textColor="@color/white_pure"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Active Reply Banner -->
    <LinearLayout
        android:id="@+id/layout_active_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_active_reply_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="پاسخ به..."
            android:textColor="@color/white_platinum"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/btn_cancel_reply"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/gray_text" />
    </LinearLayout>

    <!-- Messages Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_messages"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingVertical="8dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="هنوز پیامی دریافت نشده است"
                android:textColor="@color/white_pure"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="در حال حاضر منبع CHAT-MAXO.json خالی است.\nمی‌توانید پیام بفرستید یا صفحه را بازنشانی کنید."
                android:textColor="@color/gray_muted"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Input Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Formatting quick actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/btn_format_bold"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_rounded_card"
                android:minWidth="32dp"
                android:paddingHorizontal="8dp"
                android:text="B"
                android:textColor="@color/white_pure"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_format_italic"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_rounded_card"
                android:minWidth="32dp"
                android:paddingHorizontal="8dp"
                android:text="I"
                android:textColor="@color/white_pure"
                android:textSize="11sp"
                android:textStyle="italic" />

            <Button
                android:id="@+id/btn_format_quote"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_rounded_card"
                android:minWidth="32dp"
                android:paddingHorizontal="8dp"
                android:text="&gt;"
                android:textColor="@color/white_pure"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_react_heart"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_rounded_card"
                android:minWidth="32dp"
                android:paddingHorizontal="6dp"
                android:text="❤️"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_react_fire"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_rounded_card"
                android:minWidth="32dp"
                android:paddingHorizontal="6dp"
                android:text="🔥"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Message Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/et_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:hint="@string/chat_input_hint"
                android:textColorHint="@color/gray_muted"
                android:textColor="@color/white_pure"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="13sp"
                android:maxLines="4" />

            <FrameLayout
                android:id="@+id/btn_send"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_rounded_card"
                android:backgroundTint="@color/white_pure"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_send"
                    app:tint="@color/bg_dark" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
