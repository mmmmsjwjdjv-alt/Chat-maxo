<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp" />

        <!-- Logo Monogram -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_rounded_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="M"
                android:textColor="@color/white_pure"
                android:textSize="28sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="MAXO CHAT"
            android:textColor="@color/white_pure"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="پیام‌رسان حرفه‌ای با معماری بومی اندروید"
            android:textColor="@color/gray_text"
            android:textSize="12sp" />

        <!-- Tab Toggle Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_input_field"
            android:orientation="horizontal"
            android:padding="4dp">

            <Button
                android:id="@+id/tab_login"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/white_pure"
                android:text="ورود به حساب"
                android:textColor="@color/bg_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/tab_register"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@android:color/transparent"
                android:text="ثبت‌نام جدید"
                android:textColor="@color/gray_text"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <!-- Error Message Text -->
        <TextView
            android:id="@+id/tv_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_rounded_card"
            android:padding="12dp"
            android:textColor="@color/accent_red"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Input Fields Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="نام کاربری (حروف انگلیسی و اعداد):"
                android:textColor="@color/gray_text"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="مثال: maxo_user"
                android:textColorHint="@color/gray_muted"
                android:textColor="@color/white_pure"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />

            <!-- Display Name (Register only) -->
            <TextView
                android:id="@+id/tv_label_display_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="نام نمایشی (اختیاری):"
                android:textColor="@color/gray_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_display_name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="نامی که در چت نمایش داده می‌شود"
                android:textColorHint="@color/gray_muted"
                android:textColor="@color/white_pure"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:singleLine="true"
                android:visibility="gone" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="رمز عبور:"
                android:textColor="@color/gray_text"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="حداقل ۶ کاراکتر"
                android:textColorHint="@color/gray_muted"
                android:textColor="@color/white_pure"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:inputType="textPassword"
                android:singleLine="true" />

            <!-- Confirm Password (Register only) -->
            <TextView
                android:id="@+id/tv_label_confirm_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="6dp"
                android:text="تکرار رمز عبور:"
                android:textColor="@color/gray_text"
                android:textSize="11sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/bg_input_field"
                android:hint="تکرار همان رمز"
                android:textColorHint="@color/gray_muted"
                android:textColor="@color/white_pure"
                android:paddingHorizontal="16dp"
                android:textSize="13sp"
                android:inputType="textPassword"
                android:singleLine="true"
                android:visibility="gone" />

            <!-- Submit Button -->
            <Button
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/white_pure"
                android:text="ورود به حساب"
                android:textColor="@color/bg_dark"
                android:textSize="14sp"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>

        <!-- Initial Owner Information Note -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_rounded_card"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👑 حساب کاربری اولیه مالک سیستم"
                android:textColor="@color/white_pure"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="نام کاربری: MAXO\nرمز اولیه: MAXO1212"
                android:textColor="@color/gray_text"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
