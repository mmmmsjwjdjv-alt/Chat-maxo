<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <!-- Avatar circle -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_rounded_card">

        <TextView
            android:id="@+id/tv_avatar_monogram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="M"
            android:textColor="@color/white_pure"
            android:textSize="14sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Message bubble content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">

        <!-- Sender info row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tv_sender_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="کاربر"
                android:textColor="@color/white_pure"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_sender_username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="\@user"
                android:textColor="@color/gray_muted"
                android:textSize="10sp" />

            <!-- Role Badge -->
            <TextView
                android:id="@+id/tv_role_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_rounded_card"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="مدیر"
                android:textColor="@color/white_pure"
                android:textSize="9sp"
                android:visibility="gone" />

            <!-- Remote Source Badge -->
            <TextView
                android:id="@+id/tv_remote_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_rounded_card"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="آنلاین"
                android:textColor="@color/accent_green"
                android:textSize="8sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Bubble Body -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_incoming"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:maxWidth="280dp">

            <!-- Reply Preview (if any) -->
            <LinearLayout
                android:id="@+id/layout_reply_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_rounded_card"
                android:padding="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_reply_snippet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="پاسخ به..."
                    android:textColor="@color/gray_text"
                    android:textSize="10sp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_message_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="متن پیام دریافتی"
                android:textColor="@color/bubble_incoming_text"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_reaction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_rounded_card"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="❤️ 1"
                    android:textColor="@color/white_pure"
                    android:textSize="9sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:30"
                    android:textColor="@color/gray_muted"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
